# For the command-line check only (python -m neuro.analyze_video). The app's backend reads
# NEURO_SCORE_URL from backend/.env instead. URLs are printed by `modal deploy api/modal_app.py`.
NEURO_ANALYZE_URL=https://<workspace>--neuro-engagement-neuro-analyze.modal.run
NEURO_SCORE_URL=https://<workspace>--neuro-engagement-neuro-neuro-score.modal.run
