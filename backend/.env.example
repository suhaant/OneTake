GEMINI_API_KEY=replace_me
# TigerData (Timescale) service URL. Leave unset to use the local JSON store.
# DATABASE_URL=postgres://tsdbadmin:password@host.tsdb.cloud.timescale.com:port/tsdb?sslmode=require
# Optional model overrides. Defaults are gemini-3.8-flash for text/video
# evaluation and gemini-3.5-transcribe for timestamped transcription.
SEMANTIC_MODEL=gemini-3.8-flash
VIDEO_MODEL=gemini-3.8-flash
UPLOAD_DIR=data/uploads
STORE_PATH=data/submissions.json
# Neuro API for the brain-response panel: the neuro-score URL printed by
# `modal deploy neuro/api/modal_app.py`. Keep it private. Leave unset to turn the panel off.
NEURO_SCORE_URL=
# ElevenLabs: the panda coach's voice (greeting, countdown, tips, verdict). Leave unset for a silent panda.
ELEVENLABS_API_KEY=
# Optional: another voice from GET https://api.elevenlabs.io/v1/voices, and the model (eleven_v3 supports [excited]-style tags).
# ELEVENLABS_VOICE_ID=N2lVS1w4EtoT3dr4eOWO
# ELEVENLABS_MODEL=eleven_v3
