# Gemini writes the coach's notifications. Leave blank to use the built-in templates.
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash

# Same TigerData URL the backend uses (backend/.env). Leave blank to use the in-memory store.
DATABASE_URL=
# Origin of the FastAPI backend; today's prompt is read from it.
BACKEND_URL=http://127.0.0.1:8000

# Origin challenge links are built from (the https link in the text a user sends a friend).
PUBLIC_URL=http://localhost:8787
PORT=8787

# Shared secret for /events/* and /cron/*. Required outside local dev.
INTERNAL_SECRET=
# Set to 1 to run the streak-saver check inside this process every 15 minutes.
ENABLE_CRON=0
# Days the global board looks back for each user's best take. 1 = today only; 7 keeps a seeded demo board stable.
BOARD_DAYS=1
