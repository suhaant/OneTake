# Photon (app.photon.codes -> project settings). Leave blank to run in dry-run mode:
# outbound texts are logged to the console instead of sent.
PHOTON_PROJECT_ID=
PHOTON_PROJECT_SECRET=
# Returned once when you register the webhook (see README).
SPECTRUM_WEBHOOK_SECRET=

# Gemini writes the coach's texts. Leave blank to use the built-in templates.
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.8-flash

# Same TigerData URL the backend uses (backend/.env). Leave blank to use the in-memory store.
DATABASE_URL=
# Origin of the FastAPI backend; today's prompt is read from it.
BACKEND_URL=http://127.0.0.1:8000

# Public https origin of this server; challenge links are built from it.
PUBLIC_URL=http://localhost:8787
PORT=8787

# Shared secret for /events/* and /cron/*. Required outside local dev.
INTERNAL_SECRET=
# Set to 1 to run the streak-saver check inside this process every 15 minutes.
ENABLE_CRON=0
